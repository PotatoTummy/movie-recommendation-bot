# ===================================================
# LiveKit Cloud Credentials (from https://cloud.livekit.io/projects/p_48rzw0dn4jb/settings/keys)
# ===================================================
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ===================================================
# TMDB API Credentials (from themoviedb.org)
# ===================================================
TMDB_API_KEY=your_tmdb_api_key_v3
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_v4

# ===================================================
# AI & Voice Providers
# ===================================================
# OpenAI for LLM reasoning and default voice/transcription
OPENAI_API_KEY=your_openai_api_key

# Optional specialized voice providers (can be added later if desired):
# DEEPGRAM_API_KEY=your_deepgram_api_key
# CARTESIA_API_KEY=your_cartesia_api_key

