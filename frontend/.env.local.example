# ===================================================
# LiveKit Cloud Credentials (Server-side Token Generation)
# ===================================================
# These are used strictly inside the Next.js API route (/api/token) to sign ephemeral JWTs
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Public LiveKit WebSocket URL passed to the client browser
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud

